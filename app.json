{
  "expo": {
    "name": "finance-diario",
    "slug": "finance-diario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.financediario",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anonymous.financediario",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Finance Diário usa o microfone para você ditar as notas de lançamento.",
          "speechRecognitionPermission": "O Finance Diário transcreve a sua fala para criar notas de lançamento."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 128,
          "backgroundColor": "#f2f5f3",
          "dark": {
            "backgroundColor": "#0b1210"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ab59064-760d-46d1-94b6-ce5a514c13be"
      }
    }
  }
}
