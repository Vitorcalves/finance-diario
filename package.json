{
  "name": "finance-diario",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx --tsconfig tsconfig.test.json --test --disable-warning=ExperimentalWarning \"src/**/*.test.ts\"",
    "test:watch": "tsx --tsconfig tsconfig.test.json --test --watch --disable-warning=ExperimentalWarning \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify:planos": "tsx scripts/verifica-planos.ts"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.5",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "dayjs": "^1.11.20",
    "expo": "^58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-sharing": "~58.0.22",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true
}
